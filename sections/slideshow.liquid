{%- capture section_settings -%}
{
  "autoPlay": {{ section.settings.autoplay | json }},
  "prevNextButtons": true,
  "pageDots": {% if section.blocks.size > 1 %}true{% else %}false{% endif %},
  "setGallerySize": true,
  "adaptiveHeight": false,
  "transitionEffect": {{ section.settings.carousel_effect | json }},
  "cycleSpeed": 8000
}
{%- endcapture -%}
<section data-section-id="{{ section.id }}" data-section-type="slideshow" data-section-settings='{{ section_settings }}'>
  <div {% unless section.settings.edge_to_edge %}class="container container--flush mt-main-slideshow-shell"{% endunless %}>
    <div class="slideshow slideshow--preserve-ratio {% if section.settings.edge_to_edge %}slideshow--edge2edge{% endif %}" style="color:{{ section.blocks.first.settings.text_color }}">
      {%- for block in section.blocks -%}
        {%- assign desktop_image = block.settings.image -%}
        {%- assign mobile_image = block.settings.mobile_image | default: desktop_image -%}
        {%- capture slide_inner -%}
          <div class="slideshow__slide-inner slideshow__slide-inner--{{ block.settings.content_position | replace: '_', '-' }}">
            <picture class="mt-main-banner-frame">
              {%- if mobile_image != blank -%}<source media="(max-width:640px)" srcset="{{ mobile_image | img_url: '750x1100', crop: 'center' }}">{%- endif -%}
              {%- if desktop_image != blank -%}
                <img class="slideshow__image mt-main-banner-image" src="{{ desktop_image | img_url: '1800x600', crop: 'center' }}" alt="{{ desktop_image.alt | escape }}" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image-placeholder' }}
              {%- endif -%}
            </picture>
            {%- if block.settings.title != blank or block.settings.content != blank or block.settings.button_text != blank -%}
              <div class="slideshow__content-wrapper"><div class="container">
                {%- if block.settings.title != blank -%}<h2 class="slideshow__title heading h1">{{ block.settings.title | escape }}</h2>{%- endif -%}
                {%- if block.settings.content != blank -%}<p class="slideshow__content">{{ block.settings.content | escape | newline_to_br }}</p>{%- endif -%}
                {%- if block.settings.link != blank and block.settings.button_text != blank -%}<a href="{{ block.settings.link }}" class="slideshow__button button">{{ block.settings.button_text | escape }}</a>{%- endif -%}
              </div></div>
            {%- endif -%}
          </div>
          <style>#block-{{ block.id }}{color:{{ block.settings.text_color }}}#block-{{ block.id }} .button{color:{{ block.settings.button_text_color }};background:{{ block.settings.button_background }}}{% if block.settings.show_overlay %}#block-{{ block.id }}.slideshow__slide--overlay:before{background:rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }})}{% endif %}</style>
        {%- endcapture -%}
        {%- if block.settings.link != blank and block.settings.button_text == blank -%}<a href="{{ block.settings.link }}" class="slideshow__slide {% if block.settings.show_overlay %}slideshow__slide--overlay{% endif %} {% if forloop.first %}is-selected{% endif %}" id="block-{{ block.id }}" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ slide_inner }}</a>{%- else -%}<div class="slideshow__slide {% if block.settings.show_overlay %}slideshow__slide--overlay{% endif %} {% if forloop.first %}is-selected{% endif %}" id="block-{{ block.id }}" data-block-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ slide_inner }}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
[data-section-type="slideshow"] .mt-main-slideshow-shell{padding-top:0!important;padding-bottom:0!important;background:#050506!important}
[data-section-type="slideshow"] .slideshow,[data-section-type="slideshow"] .flickity-viewport,[data-section-type="slideshow"] .slideshow__slide,[data-section-type="slideshow"] .slideshow__slide-inner{background:#050506!important}
.mt-main-banner-frame{display:block;position:relative;width:100%;aspect-ratio:3/1;overflow:hidden;line-height:0;background:#050506}
.mt-main-banner-image{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;max-width:none!important;object-fit:cover!important;object-position:center!important;display:block!important;opacity:1!important;visibility:visible!important}
[data-section-type="slideshow"] .flickity-prev-next-button{display:block!important;opacity:1!important;visibility:visible!important;z-index:10!important}
[data-section-type="slideshow"] .flickity-page-dots{z-index:10!important}
@media(max-width:640px){.mt-main-banner-frame{aspect-ratio:15/22!important}.mt-main-banner-image{object-position:center!important}}
</style>
{% schema %}{"name":"Slideshow","max_blocks":6,"settings":[{"type":"checkbox","id":"removeLazyLoad","label":"improve FCP","info":"remove lazyload from first image","default":false},{"type":"checkbox","id":"edge_to_edge","label":"Full-width","default":false},{"type":"checkbox","id":"redondo","label":"Slider arredondado","default":false},{"type":"checkbox","id":"active_zoom","label":"Slider com zoom","default":true},{"type":"select","id":"section_size","label":"Image size","options":[{"value":"preserve_ratio","label":"Original image ratio"},{"value":"small","label":"Small"},{"value":"medium","label":"Medium"},{"value":"large","label":"Large"}],"default":"preserve_ratio"},{"type":"select","id":"carousel_effect","label":"Transition effect","options":[{"value":"fade","label":"Fade"},{"value":"slide","label":"Slide"}],"default":"slide"},{"type":"checkbox","id":"autoplay","label":"Auto rotate between slides","default":true},{"type":"checkbox","id":"slideduvidas","label":"Slide de dúvidas","default":false},{"type":"range","id":"cycle_speed","min":3,"max":8,"step":1,"unit":"sec","label":"Change slides every","default":8}],"blocks":[{"type":"image","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Image","info":"1800 x 600px .jpg recommended"},{"type":"image_picker","id":"mobile_image","label":"Mobile image","info":"750 x 1100px .jpg recommended. If none is set, desktop image will be used."},{"type":"checkbox","id":"show_overlay","label":"Show overlay","info":"Increase text readability on busy images.","default":false},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":100,"step":1,"unit":"%","default":30},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"text","id":"title","label":"Heading","default":"Slide title"},{"type":"textarea","id":"content","label":"Content","default":"Tell your story"},{"type":"select","id":"content_position","label":"Content position","options":[{"value":"top_left","label":"Top left"},{"value":"top_center","label":"Top center"},{"value":"top_right","label":"Top right"},{"value":"middle_left","label":"Middle left"},{"value":"middle_center","label":"Middle center"},{"value":"middle_right","label":"Middle right"},{"value":"bottom_left","label":"Bottom left"},{"value":"bottom_center","label":"Bottom center"},{"value":"bottom_right","label":"Bottom right"}],"default":"middle_center"},{"type":"header","content":"Button"},{"type":"color","id":"button_background","label":"Background","default":"#ffffff"},{"type":"color","id":"button_text_color","label":"Text","default":"#000000"},{"type":"text","id":"button_text","label":"Text","default":"Button"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"category":"Image","name":"Slideshow","blocks":[{"type":"image"},{"type":"image"}]}]}{% endschema %}