{{ 'mt-home-experience.css' | asset_url | stylesheet_tag }}
{{ 'mt-home-mobile-v15.css' | asset_url | stylesheet_tag }}

{% assign ready_collection = collections[section.settings.ready_collection] %}
{% assign brazil_collection = collections[section.settings.brazil_collection] %}
{% assign europe_collection = collections[section.settings.europe_collection] %}
{% assign selections_collection = collections[section.settings.selections_collection] %}
{% assign retro_collection = collections[section.settings.retro_collection] %}
{% assign kids_collection = collections[section.settings.kids_collection] %}
{% assign nba_collection = collections[section.settings.nba_collection] %}
{% assign pix_discount = settings.desconto_pix | default: 5 | plus: 0 %}
{% assign pix_factor = 100 | minus: pix_discount | divided_by: 100.0 %}

<div class="mt-home">
  <section class="mt-slider" aria-label="Destaques MT Sports">
    <div class="mt-slide mt-slide--existing mt-slide--one">
      <picture>
        {% if section.settings.slide1_mobile != blank %}<source media="(max-width:700px)" srcset="{{ section.settings.slide1_mobile | image_url: width: 1200 }}">{% else %}<source media="(max-width:700px)" srcset="{{ images['Anderson-Porfirio-mobile.png'] | img_url: 'master' }}">{% endif %}
        {% if section.settings.slide1_desktop != blank %}<img src="{{ section.settings.slide1_desktop | image_url: width: 2400 }}" alt="Compre 2 e leve 3 na MT Sports" loading="eager">{% else %}<img src="{{ images['Anderson-Porfirio-pc.png'] | img_url: 'master' }}" alt="Compre 2 e leve 3 na MT Sports" loading="eager">{% endif %}
      </picture>
    </div>
    <div class="mt-slide mt-slide--ready">
      <div class="mt-slide__photo"></div><img class="mt-hero__smoke" src="{{ 'mt-smoke-overlay.png' | asset_url }}" alt=""><div class="mt-slide__shade"></div>
      <div class="mt-shell mt-slide__content"><h1>PRONTA<br><span>ENTREGA</span></h1><p>Produtos selecionados com envio imediato e entrega de 7 a 15 dias úteis.</p><a class="mt-button" href="{{ ready_collection.url | default: '/collections/pronta-entrega' }}">VER PRODUTOS</a></div>
    </div>
    <div class="mt-slide mt-slide--existing mt-slide--three">
      <picture>
        {% if section.settings.slide3_mobile != blank %}<source media="(max-width:700px)" srcset="{{ section.settings.slide3_mobile | image_url: width: 1200 }}">{% else %}<source media="(max-width:700px)" srcset="{{ images['neymar_vertical_mesma_proporcao.png'] | img_url: 'master' }}">{% endif %}
        {% if section.settings.slide3_desktop != blank %}<img src="{{ section.settings.slide3_desktop | image_url: width: 2400 }}" alt="Camisas 2026 e 2027 disponíveis" loading="lazy">{% else %}<img src="{{ images['ChatGPT_Image_15_de_ago._de_2026_03_41_33.png'] | img_url: 'master' }}" alt="Camisas 2026 e 2027 disponíveis" loading="lazy">{% endif %}
      </picture>
    </div>
    <div class="mt-slide mt-slide--existing mt-slide--four">
      <a class="mt-slide__full-link" href="/pages/prazo-e-funcionamento-das-entregas" aria-label="Conheça nossos métodos, prazos e funcionamento das entregas"><picture>
        {% if section.settings.slide4_mobile != blank %}<source media="(max-width:700px)" srcset="{{ section.settings.slide4_mobile | image_url: width: 1200 }}">{% else %}<source media="(max-width:700px)" srcset="{{ images['ChatGPT_Image_15_de_ago._de_2026_21_15_02.png'] | img_url: 'master' }}">{% endif %}
        {% if section.settings.slide4_desktop != blank %}<img src="{{ section.settings.slide4_desktop | image_url: width: 2400 }}" alt="Conheça os métodos de envio da MT Sports" loading="lazy">{% else %}<img src="{{ images['ChatGPT_Image_15_de_ago._de_2026_21_07_59.png'] | img_url: 'master' }}" alt="Conheça os métodos de envio da MT Sports" loading="lazy">{% endif %}
      </picture></a>
    </div>
    <div class="mt-slider__dots" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  </section>

  <section class="mt-benefits" aria-label="Vantagens da MT Sports"><div class="mt-shell mt-benefits__grid">
    <div><span class="mt-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7zM6 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm11 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/></svg></span><p><strong>ENVIO IMEDIATO</strong><span>Seleção em estoque no Brasil</span></p></div>
    <div><span class="mt-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 10V7a6 6 0 0 1 12 0v3h2v11H4V10Zm3 0h6V7a3 3 0 0 0-6 0Z"/></svg></span><p><strong>COMPRA SEGURA</strong><span>Ambiente protegido e suporte real</span></p></div>
    <div><span class="mt-benefit-icon mt-benefit-icon--cart" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M2 3h3l2.1 11.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 1.9-1.4L22 7H7.2l.5 2H19l-1.3 4.8H9L6.8 3H2Zm8 18a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm8 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="M10 5h2V2h2v3h2v2h-2v3h-2V7h-2Z"/></svg></span><p><strong>LEVE 3, PAGUE 2</strong><span>Combine produtos participantes</span></p></div>
    <div><span class="mt-benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 13a8 8 0 0 1 16 0v6h-5v-7h3a6 6 0 0 0-12 0h3v7H4Zm14 6h2c0 2-2 3-5 3v-2c2 0 3-.3 3-1Z"/></svg></span><p><strong>ATENDIMENTO</strong><span>Fale com a MT Sports no WhatsApp</span></p></div>
  </div></section>

  {% if ready_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>DISPONÍVEIS AGORA</span><h2>PRONTA ENTREGA</h2></div><a href="{{ ready_collection.url }}">VER TODOS</a></div><div class="mt-products">
    {% for product in ready_collection.products limit: 6 %}{% assign pix_price = product.price | times: pix_factor %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% endif %}<span class="mt-card__stock">PRONTA ENTREGA</span></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ pix_price | money }} <small>no Pix</small></div><div class="mt-card__installment">ou {{ product.price | money }} nos demais pagamentos</div><div class="mt-card__promo"><span>MT</span><strong>LEVE 3 • PAGUE 2</strong><small>Combine seus produtos</small></div></div></article>{% endfor %}
  </div></div></section>{% endif %}

  <section class="mt-categories mt-section"><div class="mt-shell"><div class="mt-heading mt-heading--center"><div><span>{{ section.settings.categories_eyebrow | default: 'ENCONTRE SEU MANTO' }}</span><h2>{{ section.settings.categories_title | default: 'ESCOLHA SEU MANTO' }}</h2></div></div><div class="mt-categories__grid">
    <a class="mt-category mt-category--brasil" href="{{ brazil_collection.url | default: '/collections/camisas-nacionais' }}"{% if section.settings.category_brazil_image != blank %} style="background-image:url('{{ section.settings.category_brazil_image | image_url: width: 1200 }}')!important"{% endif %}><span class="mt-category__shade"></span><strong>BRASILEIROS</strong><small>Clubes de todo o Brasil</small></a>
    <a class="mt-category mt-category--europe" href="{{ europe_collection.url | default: '/collections/europeus' }}"{% if section.settings.category_europe_image != blank %} style="background-image:url('{{ section.settings.category_europe_image | image_url: width: 1200 }}')!important"{% endif %}><span class="mt-category__shade"></span><strong>EUROPEUS</strong><small>Os gigantes da Europa</small></a>
    <a class="mt-category mt-category--selections" href="{{ selections_collection.url | default: '/collections/selecoes' }}"{% if section.settings.category_selections_image != blank %} style="background-image:url('{{ section.settings.category_selections_image | image_url: width: 1200 }}')!important"{% endif %}><span class="mt-category__shade"></span><strong>SELEÇÕES</strong><small>Vista as cores do seu país</small></a>
    <a class="mt-category mt-category--retro" href="{{ retro_collection.url | default: '/collections/retro-1' }}"{% if section.settings.category_retro_image != blank %} style="background-image:url('{{ section.settings.category_retro_image | image_url: width: 1200 }}')!important"{% endif %}><span class="mt-category__shade"></span><strong>RETRÔ</strong><small>Relíquias do futebol</small></a>
  </div></div></section>

