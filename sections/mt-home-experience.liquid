{{ 'mt-home-experience.css' | asset_url | stylesheet_tag }}
{{ 'mt-home-mobile-v15.css' | asset_url | stylesheet_tag }}
{% assign ready_collection = collections[section.settings.ready_collection] %}{% if ready_collection == blank %}{% assign ready_collection = collections['pronta-entrega-🔥'] %}{% endif %}
{% assign international_collection = collections[section.settings.international_collection] %}{% if international_collection == blank %}{% assign international_collection = collections['europeus-manual'] %}{% endif %}
{% assign nba_collection = collections[section.settings.nba_collection] %}{% if nba_collection == blank %}{% assign nba_collection = collections['nba-manual'] %}{% endif %}
{% assign winter_collection = collections[section.settings.winter_collection] %}{% if winter_collection == blank %}{% assign winter_collection = collections['kit-de-inverno'] %}{% endif %}
{% assign retro_collection = collections[section.settings.retro_collection] %}{% if retro_collection == blank %}{% assign retro_collection = collections['retro-1'] %}{% endif %}
<div class="mt-home">
  {% if ready_collection != blank %}
  <section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>DISPONÍVEIS AGORA</span><h2>PRONTA ENTREGA</h2></div><a href="{{ ready_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in ready_collection.products limit:6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}"><img src="{{ product.featured_image | img_url:'600x' }}" alt="{{ product.title | escape }}"><span class="mt-card__stock">PRONTA ENTREGA</span></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>
  {% endif %}

  {% if international_collection != blank %}
  <section class="mt-section mt-section--dark mt-section--alternate"><div class="mt-shell"><div class="mt-heading"><div><span>DO FUTEBOL MUNDIAL PARA VOCÊ</span><h2>EUROPEUS</h2></div><a href="{{ international_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in international_collection.products limit:6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}"><img src="{{ product.featured_image | img_url:'600x' }}" alt="{{ product.title | escape }}"></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>
  {% endif %}

  <section class="mt-section mt-categories"><div class="mt-shell"><div class="mt-heading"><div><span>ESCOLHA ONDE A PAIXÃO JOGA</span><h2>CATEGORIAS</h2></div></div><div class="mt-categories__grid">
    <a class="mt-category mt-category--brasil" href="/collections/camisas-nacionais"><span class="mt-category__shade"></span><strong>BRASILEIRÃO</strong><small>Os gigantes do Brasil</small></a>
    <a class="mt-category mt-category--europe" href="/collections/europeus-manual"><span class="mt-category__shade"></span><strong>EUROPEUS</strong><small>Os maiores da Europa</small></a>
    <a class="mt-category mt-category--selections" href="/collections/selecoes"><span class="mt-category__shade"></span><strong>SELEÇÕES</strong><small>Vista as cores do seu país</small></a>
    <a class="mt-category mt-category--retro" href="/collections/retro-1"><span class="mt-category__shade"></span><strong>RETRÔ</strong><small>Camisas que marcaram época</small></a>
  </div></div></section>

  <section class="mt-hero mt-hero--nba"><div class="mt-hero__photo"></div><div class="mt-hero__shade"></div><div class="mt-shell mt-hero__content"><span class="mt-kicker">DIRETO DAS QUADRAS</span><h2>NBA<br><span>LEGENDS</span></h2><p>Regatas e clássicos de quem fez história no basquete.</p>{% if nba_collection != blank %}<a class="mt-button" href="{{ nba_collection.url }}">VER NBA</a>{% endif %}</div></section>
  {% if nba_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>NBA LEGENDS</span><h2>REGATAS NBA</h2></div><a href="{{ nba_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in nba_collection.products limit:6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}"><img src="{{ product.featured_image | img_url:'600x' }}" alt="{{ product.title | escape }}"></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>{% endif %}

  {% if winter_collection != blank %}<section class="mt-section mt-section--dark mt-section--alternate"><div class="mt-shell"><div class="mt-heading"><div><span>O FRIO VEM AÍ</span><h2>CONJUNTOS DE INVERNO</h2></div><a href="{{ winter_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in winter_collection.products limit:6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}"><img src="{{ product.featured_image | img_url:'600x' }}" alt="{{ product.title | escape }}"></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>{% endif %}

  <section class="mt-retro-feature"><img class="mt-retro-feature__photo mt-retro-feature__photo--desktop" src="{{ 'mt-ronaldinho-user-desktop.webp' | asset_url }}" alt="Boas lembranças — camisas retrô"><img class="mt-retro-feature__photo mt-retro-feature__photo--mobile" src="{{ 'mt-ronaldinho-user-mobile.webp' | asset_url }}" alt="Boas lembranças — camisas retrô" hidden><div class="mt-retro-feature__shade"></div><div class="mt-shell mt-retro-feature__content"><span class="mt-kicker">RELÍQUIAS DO FUTEBOL</span><h2>BOAS<br>LEMBRANÇAS</h2><p>Camisas que atravessaram gerações e continuam fazendo história.</p>{% if retro_collection != blank %}<a class="mt-button" href="{{ retro_collection.url }}">VER CAMISAS RETRÔ</a>{% endif %}</div></section>
  {% if retro_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>BOAS LEMBRANÇAS</span><h2>CAMISAS RETRÔ</h2></div><a href="{{ retro_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in retro_collection.products limit:6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}"><img src="{{ product.featured_image | img_url:'600x' }}" alt="{{ product.title | escape }}"></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>{% endif %}
</div>
{% schema %}{"name":"MT Sports — Home","settings":[{"type":"collection","id":"ready_collection","label":"Pronta entrega"},{"type":"collection","id":"international_collection","label":"Europeus / Internacional"},{"type":"collection","id":"nba_collection","label":"NBA"},{"type":"collection","id":"winter_collection","label":"Conjuntos de inverno"},{"type":"collection","id":"retro_collection","label":"Retrô"}],"presets":[{"name":"MT Sports — Home"}]}{% endschema %}