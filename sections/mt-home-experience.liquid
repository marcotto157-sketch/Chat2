{
  "name":"MT Sports — Home",
  "settings":[
    {"type":"header","content":"Coleções da home"},
    {"type":"collection","id":"ready_collection","label":"Pronta entrega"},
    {"type":"collection","id":"brazil_collection","label":"Campeonato Brasileiro"},
    {"type":"collection","id":"selections_collection","label":"Seleções"},
    {"type":"collection","id":"europe_collection","label":"Europeus"},
    {"type":"collection","id":"kids_collection","label":"Kits infantis"},
    {"type":"collection","id":"nba_collection","label":"NBA"},
    {"type":"collection","id":"retro_collection","label":"Retrô"},
    {"type":"header","content":"Área de categorias"},
    {"type":"text","id":"categories_eyebrow","label":"Texto pequeno","default":"ENCONTRE SEU MANTO"},
    {"type":"text","id":"categories_title","label":"Título","default":"ESCOLHA SEU MANTO"},
    {"type":"image_picker","id":"category_brazil_image","label":"Imagem — Brasileiros"},
    {"type":"image_picker","id":"category_europe_image","label":"Imagem — Europeus"},
    {"type":"image_picker","id":"category_selections_image","label":"Imagem — Seleções"},
    {"type":"image_picker","id":"category_retro_image","label":"Imagem — Retrô"},
