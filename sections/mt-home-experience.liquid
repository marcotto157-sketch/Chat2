{{ 'mt-home-mobile-v15.css' | asset_url | stylesheet_tag }}
{{ 'mt-final-fixes-v20.css' | asset_url | stylesheet_tag }}
{{ 'mt-mobile-visibility-v34.css' | asset_url | stylesheet_tag }}

<div class="mt-home">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'collection_showcase' %}
        {% assign featured_collection = block.settings.collection %}
        {% if featured_collection != blank and featured_collection.products_count > 0 %}
          <section class="mt-section{% if block.settings.background == 'dark' %} mt-section--dark{% else %} mt-section--alternate{% endif %}" {{ block.shopify_attributes }}>
            <div class="mt-shell">
              <div class="mt-heading">
                <div>
                  {% if block.settings.eyebrow != blank %}<span>{{ block.settings.eyebrow }}</span>{% endif %}
                  <h2>{{ block.settings.title | default: featured_collection.title }}</h2>
                  {% if block.settings.message != blank %}<p class="mt-section-message">{{ block.settings.message }}</p>{% endif %}
                </div>
                <a href="{{ featured_collection.url }}">{{ block.settings.link_label | default: 'VER TODOS' }}</a>
              </div>
              <div class="mt-products">
                {% for product in featured_collection.products limit: block.settings.products_limit %}
                  {% assign product_title_upper = product.title | upcase %}
                  {% assign show_promo = false %}
                  {% if block.settings.promo_badge and product_title_upper contains 'CAMISA' %}
                    {% unless product_title_upper contains 'JOGADOR' or product_title_upper contains 'PLAYER' or product_title_upper contains 'RETRÔ' or product_title_upper contains 'RETRO' or product_title_upper contains 'INFANTIL' or product_title_upper contains 'NBA' %}{% assign show_promo = true %}{% endunless %}
                  {% endif %}
                  <article class="mt-card">
                    <a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}{% if block.settings.ready_badge %}<span class="mt-card__stock">PRONTA ENTREGA</span>{% endif %}</a>
                    <div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div><div class="mt-card__installment">ou em até 12x no cartão</div>{% if show_promo %}<div class="mt-card__promo" aria-label="Leve 3, pague 2 MT"><span>MT</span><strong>LEVE 3, PAGUE 2</strong></div>{% endif %}</div>
                  </article>
                {% endfor %}
              </div>
            </div>
          </section>
        {% endif %}

      {% when 'categories' %}
        {% assign brasileiros = collections['camisas-nacionais'] %}{% assign europeus = collections['europeus'] %}{% assign selecoes = collections['selecoes'] %}{% assign retro = collections['retro-1'] %}
        <section class="mt-section mt-categories" {{ block.shopify_attributes }}><div class="mt-shell"><div class="mt-heading"><div><span>ENCONTRE SEU TIME</span><h2>Categorias</h2></div></div><div class="mt-categories__grid"><a class="mt-category mt-category--brasil" href="{{ brasileiros.url | default: '/collections/camisas-nacionais' }}"><div class="mt-category__shade"></div><strong>BRASILEIROS</strong><small>Clubes do futebol nacional</small></a><a class="mt-category mt-category--europe" href="{{ europeus.url | default: '/collections/europeus' }}"><div class="mt-category__shade"></div><strong>EUROPEUS</strong><small>Os gigantes da Europa</small></a><a class="mt-category mt-category--selections" href="{{ selecoes.url | default: '/collections/selecoes' }}"><div class="mt-category__shade"></div><strong>SELEÇÕES</strong><small>Camisas de seleções</small></a><a class="mt-category mt-category--retro" href="{{ retro.url | default: '/collections/retro-1' }}"><div class="mt-category__shade"></div><strong>RETRÔS</strong><small>Clássicos que fizeram história</small></a></div></div></section>

      {% when 'nba_hero' %}
        {% assign nba = collections['nba-1'] %}<section class="mt-hero mt-hero--nba" {{ block.shopify_attributes }}><div class="mt-hero__photo"></div><div class="mt-hero__shade"></div><div class="mt-shell mt-hero__content"><span class="mt-kicker">BASQUETE</span><h2>REGATAS<br><span>NBA</span></h2><p>Modelos atuais e clássicos para quem vive o basquete.</p><a class="mt-button" href="{{ nba.url | default: '/collections/nba-1' }}">VER REGATAS</a></div></section>

      {% when 'retro_hero' %}
        {% assign retro = collections['retro-1'] %}<section class="mt-retro-feature" {{ block.shopify_attributes }}><img class="mt-retro-feature__photo mt-retro-feature__photo--desktop" src="{{ 'mt-ronaldinho-retro-v6.jpg' | asset_url }}" alt="Camisas retrô" loading="lazy"><img class="mt-retro-feature__photo mt-retro-feature__photo--mobile" src="{{ 'mt-ronaldinho-retro-mobile-v20.jpg' | asset_url }}" alt="Camisas retrô" loading="lazy" hidden><div class="mt-retro-feature__shade"></div><div class="mt-shell mt-retro-feature__content"><span class="mt-kicker">BOAS LEMBRANÇAS</span><h2>CAMISAS<br>RETRÔ</h2><p>Histórias que marcaram gerações.</p><a class="mt-button" href="{{ retro.url | default: '/collections/retro-1' }}">VER RETRÔS</a></div></section>
    {% endcase %}
  {% endfor %}
</div>

<style>.mt-home .mt-section-message{margin:10px 0 0;color:#aeb3bc;font-size:14px;line-height:1.45;max-width:560px}.mt-home .mt-card__promo strong{grid-row:1/3;align-self:center}@media(max-width:700px){.mt-home .mt-section-message{font-size:12px;margin-top:7px}.mt-home .mt-categories__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}}</style>

