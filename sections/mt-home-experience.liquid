  {% if selections_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>VISTA SUAS CORES</span><h2>SELEÇÕES</h2></div><a href="{{ selections_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in selections_collection.products limit: 6 %}{% assign pix_price = product.price | times: pix_factor %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ pix_price | money }} <small>no Pix</small></div><div class="mt-card__installment">ou {{ product.price | money }} nos demais pagamentos</div><div class="mt-card__promo"><span>MT</span><strong>LEVE 3 • PAGUE 2</strong><small>Combine seus produtos</small></div></div></article>{% endfor %}</div></div></section>{% endif %}

  {% if europe_collection != blank %}<section class="mt-section mt-section--dark mt-section--alternate"><div class="mt-shell"><div class="mt-heading"><div><span>GRANDES LIGAS</span><h2>CAMISAS EUROPEIAS</h2></div><a href="{{ europe_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in europe_collection.products limit: 6 %}{% assign pix_price = product.price | times: pix_factor %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ pix_price | money }} <small>no Pix</small></div><div class="mt-card__installment">ou {{ product.price | money }} nos demais pagamentos</div><div class="mt-card__promo"><span>MT</span><strong>LEVE 3 • PAGUE 2</strong><small>Combine seus produtos</small></div></div></article>{% endfor %}</div></div></section>{% endif %}

  {% if kids_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>{{ section.settings.kids_eyebrow | default: 'PEQUENOS CRAQUES' }}</span><h2>{{ section.settings.kids_title | default: 'KITS INFANTIS' }}</h2></div><a href="{{ kids_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in kids_collection.products limit: 6 %}{% assign pix_price = product.price | times: pix_factor %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ pix_price | money }} <small>no Pix</small></div><div class="mt-card__installment">ou {{ product.price | money }} nos demais pagamentos</div><div class="mt-card__promo"><span>MT</span><strong>LEVE 3 • PAGUE 2</strong><small>Combine seus produtos</small></div></div></article>{% endfor %}</div></div></section>{% endif %}

  <section class="mt-hero mt-hero--nba" aria-label="Coleção NBA MT Sports"><div class="mt-hero__photo" role="img" aria-label="LeBron James em quadra"></div><img class="mt-hero__smoke" src="{{ 'mt-smoke-overlay.png' | asset_url }}" alt="" loading="lazy"><div class="mt-hero__shade"></div><div class="mt-shell mt-hero__content"><span class="mt-kicker">BASQUETE</span><h2>NBA<br><span>LEGENDS</span></h2><p>Regatas para quem vive o jogo dentro e fora das quadras.</p><a class="mt-button" href="{{ nba_collection.url | default: '/collections/nba-1' }}">CONHECER A COLEÇÃO</a></div></section>

  {% if nba_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>DIRETO DAS QUADRAS</span><h2>NBA ESSENTIALS</h2></div><a href="{{ nba_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in nba_collection.products limit: 6 %}{% assign pix_price = product.price | times: pix_factor %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% endif %}</a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ pix_price | money }} <small>no Pix</small></div><div class="mt-card__installment">ou {{ product.price | money }} nos demais pagamentos</div><div class="mt-card__promo"><span>MT</span><strong>LEVE 3 • PAGUE 2</strong><small>Combine seus produtos</small></div></div></article>{% endfor %}</div></div></section>{% endif %}

  <section class="mt-retro-feature" aria-label="Camisas retrô"><img class="mt-retro-feature__photo mt-retro-feature__photo--desktop" src="{% if section.settings.retro_banner_desktop != blank %}{{ section.settings.retro_banner_desktop | image_url: width: 2400 }}{% else %}{{ 'mt-ronaldinho-retro-v6.jpg' | asset_url }}{% endif %}" alt="" loading="lazy"><img class="mt-retro-feature__photo mt-retro-feature__photo--mobile" src="{% if section.settings.retro_banner_mobile != blank %}{{ section.settings.retro_banner_mobile | image_url: width: 1200 }}{% else %}{{ 'mt-ronaldinho-retro-mobile-v20.jpg' | asset_url }}{% endif %}" alt="" loading="lazy" hidden><div class="mt-retro-feature__shade"></div><div class="mt-shell mt-retro-feature__content"><span class="mt-kicker">RELÍQUIAS DO FUTEBOL</span><h2>BOAS<br>LEMBRANÇAS</h2><p>Conheça as camisetas que marcaram época.</p><a class="mt-button" href="{{ retro_collection.url | default: '/collections/retro-1' }}">VER CAMISAS RETRÔ</a></div></section>

  {% if retro_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>HISTÓRIA EM CAMPO</span><h2>CAMISAS RETRÔ</h2></div><a href="{{ retro_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in retro_collection.products limit: 6 %}{% assign pix_price = product.price | times: pix_factor %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}</a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ pix_price | money }} <small>no Pix</small></div><div class="mt-card__installment">ou {{ product.price | money }} nos demais pagamentos</div><div class="mt-card__promo"><span>MT</span><strong>LEVE 3 • PAGUE 2</strong><small>Combine seus produtos</small></div></div></article>{% endfor %}</div></div></section>{% endif %}

  <section class="mt-promo mt-section"><div class="mt-shell mt-promo__box"><div><span>OFERTA MT SPORTS</span><h2>LEVE 3, PAGUE 2</h2><p>Escolha três produtos participantes. O desconto é aplicado conforme as regras da promoção.</p></div><div class="mt-promo__seal"><b>MT</b><strong>3</strong><span>POR 2</span></div><a class="mt-button mt-button--light" href="/collections/all">ESCOLHER PRODUTOS</a></div></section>

  <section class="mt-faq mt-section"><div class="mt-shell"><div class="mt-heading mt-heading--center"><div><span>PRECISA DE AJUDA?</span><h2>DÚVIDAS FREQUENTES</h2></div></div><details><summary>Qual é o prazo da pronta entrega?</summary><p>Os produtos identificados como pronta entrega possuem envio imediato e previsão de entrega de 7 a 15 dias úteis.</p></details><details><summary>Posso personalizar minha camisa?</summary><p>Quando a opção estiver disponível no produto, você poderá escolher nome e número antes de adicionar ao carrinho.</p></details><details><summary>Como funciona o Leve 3, Pague 2?</summary><p>Adicione três produtos participantes ao carrinho e confira a aplicação da condição promocional antes de finalizar o pedido.</p></details><details><summary>Como acompanho meu pedido?</summary><p>Após o envio, você receberá o código de rastreamento para acompanhar a entrega.</p></details></div></section>
</div>

<script>document.addEventListener('DOMContentLoaded',function(){var slider=document.querySelector('.mt-slider');if(!slider)return;var slides=[].slice.call(slider.querySelectorAll('.mt-slide')),dots=[].slice.call(slider.querySelectorAll('.mt-slider__dots i')),current=0,timer,startX=null;slider.classList.add('mt-slider--js');function show(index){current=(index+slides.length)%slides.length;slides.forEach(function(slide,i){slide.classList.toggle('is-active',i===current)});dots.forEach(function(dot,i){dot.classList.toggle('is-active',i===current)})}function restart(){clearInterval(timer);timer=setInterval(function(){show(current+1)},10000)}dots.forEach(function(dot,i){dot.addEventListener('click',function(){show(i);restart()})});slider.addEventListener('pointerdown',function(e){startX=e.clientX});slider.addEventListener('pointerup',function(e){if(startX===null)return;var distance=e.clientX-startX;if(Math.abs(distance)>45){show(current+(distance<0?1:-1));restart()}startX=null});show(0);restart()});</script>

