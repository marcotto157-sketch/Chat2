{{ 'mt-home-experience.css' | asset_url | stylesheet_tag }}

{% assign pronta = collections['pronta-entrega'] %}
{% assign infantil = collections['infantil'] %}
{% assign retro = collections['retro-1'] %}

<div class="mt-home">
  {% if pronta != blank and pronta.products_count > 0 %}
    <section class="mt-section mt-section--dark">
      <div class="mt-shell">
        <div class="mt-heading">
          <div><span>ENVIO MAIS RÁPIDO</span><h2>Pronta Entrega</h2></div>
          <a href="{{ pronta.url }}">VER TODOS</a>
        </div>
        <div class="mt-products">
          {% for product in pronta.products limit: 6 %}
            <article class="mt-card">
              <a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</a>
              <div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if infantil != blank and infantil.products_count > 0 %}
    <section class="mt-section mt-section--alternate">
      <div class="mt-shell">
        <div class="mt-heading"><div><span>PARA OS PEQUENOS</span><h2>Kits Infantis</h2></div><a href="{{ infantil.url }}">VER TODOS</a></div>
        <div class="mt-products">
          {% for product in infantil.products limit: 6 %}
            <article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>
          {% endfor %}
        </div>
      </div>
    </section>
  {% endif %}

  <section class="mt-hero mt-hero--nba"><div class="mt-hero__photo"></div><div class="mt-hero__shade"></div><div class="mt-shell mt-hero__content"><span class="mt-kicker">BASQUETE</span><h2>REGATAS<br><span>NBA</span></h2><p>Modelos atuais e clássicos para quem vive o basquete.</p><a class="mt-button" href="/collections/nba-1">VER REGATAS</a></div></section>

  <section class="mt-retro-feature"><img class="mt-retro-feature__photo" src="{{ 'mt-ronaldinho-retro-v6.jpg' | asset_url }}" alt="Camisas retrô" loading="lazy"><div class="mt-retro-feature__shade"></div><div class="mt-shell mt-retro-feature__content"><span class="mt-kicker">BOAS LEMBRANÇAS</span><h2>CAMISAS<br>RETRÔ</h2><p>Histórias que marcaram gerações.</p><a class="mt-button" href="/collections/retro-1">VER RETRÔS</a></div></section>

  {% if retro != blank and retro.products_count > 0 %}
    <section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>CLÁSSICOS</span><h2>Retrôs</h2></div><a href="{{ retro.url }}">VER TODOS</a></div><div class="mt-products">{% for product in retro.products limit: 6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>
  {% endif %}
</div>

{% schema %}{"name":"MT - Home Experience","settings":[],"presets":[{"name":"MT - Home Experience"}]}{% endschema %}