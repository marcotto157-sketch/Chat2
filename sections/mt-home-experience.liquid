    {"type":"text","id":"kids_eyebrow","label":"Texto pequeno","default":"PEQUENOS CRAQUES"},
    {"type":"text","id":"kids_title","label":"Título","default":"KITS INFANTIS"},
    {"type":"header","content":"Banners do topo"},
    {"type":"image_picker","id":"slide1_desktop","label":"Banner 1 — desktop"},
    {"type":"image_picker","id":"slide1_mobile","label":"Banner 1 — mobile"},
    {"type":"image_picker","id":"slide3_desktop","label":"Banner 3 — desktop"},
    {"type":"image_picker","id":"slide3_mobile","label":"Banner 3 — mobile"},
