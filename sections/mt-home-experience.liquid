{"name":"MT - Home editável","max_blocks":16,"blocks":[{"type":"collection_showcase","name":"Vitrine de coleção","settings":[{"type":"collection","id":"collection","label":"Coleção"},{"type":"text","id":"eyebrow","label":"Texto pequeno","default":"DESTAQUES"},{"type":"text","id":"title","label":"Título"},{"type":"text","id":"message","label":"Frase de efeito"},{"type":"text","id":"link_label","label":"Texto do link","default":"VER TODOS"},{"type":"range","id":"products_limit","label":"Quantidade de produtos","min":4,"max":12,"step":1,"default":6},{"type":"select","id":"background","label":"Fundo","options":[{"value":"dark","label":"Preto"},{"value":"alternate","label":"Cinza"}],"default":"dark"},{"type":"checkbox","id":"ready_badge","label":"Mostrar selo Pronta Entrega","default":false},{"type":"checkbox","id":"promo_badge","label":"Mostrar Leve 3, Pague 2","default":false}]},{"type":"categories","name":"Categorias"},{"type":"nba_hero","name":"Arte NBA"},{"type":"retro_hero","name":"Arte Retrô"}],"presets":[{"name":"MT - Home editável","blocks":[{"type":"collection_showcase"},{"type":"collection_showcase"},{"type":"collection_showcase"},{"type":"collection_showcase"},{"type":"categories"},{"type":"collection_showcase"},{"type":"nba_hero"},{"type":"collection_showcase"},{"type":"retro_hero"},{"type":"collection_showcase"}]}]}
{% endschema %}
