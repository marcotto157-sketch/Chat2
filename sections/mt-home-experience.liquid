{{ 'mt-home-experience.css' | asset_url | stylesheet_tag }}{{ 'mt-home-mobile-v15.css' | asset_url | stylesheet_tag }}
{% assign ready_collection=collections[section.settings.ready_collection] %}{% assign winter_collection=collections[section.settings.winter_collection] %}{% if winter_collection == blank %}{% assign winter_collection=collections['kit-de-inverno'] %}{% endif %}{% assign nba_collection=collections[section.settings.nba_collection] %}{% if nba_collection == blank %}{% assign nba_collection=collections['nba-1'] %}{% endif %}{% assign retro_collection=collections[section.settings.retro_collection] %}{% if retro_collection == blank %}{% assign retro_collection=collections['retro-1'] %}{% endif %}
<div class="mt-home">
<section class="mt-slider" aria-label="Destaques MT Sports"><div class="mt-slide mt-slide--existing mt-slide--one"><picture><source media="(max-width:700px)" srcset="{{ images['Anderson-Porfirio-mobile.png'] | img_url:'master' }}"><img src="{{ images['Anderson-Porfirio-pc.png'] | img_url:'master' }}" alt="Leve 3 pague 2" loading="eager"></picture></div><div class="mt-slide mt-slide--ready"><div class="mt-slide__photo"></div><div class="mt-slide__shade"></div><div class="mt-shell mt-slide__content"><h1>PRONTA<br><span>ENTREGA</span></h1><p>Produtos selecionados com envio imediato.</p><a class="mt-button" href="{{ ready_collection.url }}">VER PRODUTOS</a></div></div></section>
{% if ready_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>DISPONÍVEIS AGORA</span><h2>PRONTA ENTREGA</h2></div><a href="{{ ready_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in ready_collection.products limit:6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}"><img src="{{ product.featured_image | img_url:'600x' }}" alt="{{ product.title | escape }}"><span class="mt-card__stock">PRONTA ENTREGA</span></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>{% endif %}
{% if winter_collection != blank %}<section class="mt-section mt-section--dark mt-winter"><div class="mt-shell"><div class="mt-heading"><div><span>O FRIO VEM AÍ</span><h2>CONJUNTOS DE INVERNO</h2></div><a href="{{ winter_collection.url }}">VER TODOS</a></div><div class="mt-products">{% for product in winter_collection.products limit:6 %}<article class="mt-card"><a class="mt-card__image" href="{{ product.url }}"><img src="{{ product.featured_image | img_url:'600x' }}" alt="{{ product.title | escape }}"></a><div class="mt-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="mt-card__price">{{ product.price | money }}</div></div></article>{% endfor %}</div></div></section>{% endif %}
<section class="mt-retro-feature"><img class="mt-retro-feature__photo mt-retro-feature__photo--desktop" src="{% if section.settings.retro_banner_desktop != blank %}{{ section.settings.retro_banner_desktop | image_url:width:2400 }}{% else %}{{ 'mt-ronaldinho-retro-v6.jpg' | asset_url }}{% endif %}" alt="Ronaldinho — camisas retrô"><img class="mt-retro-feature__photo mt-retro-feature__photo--mobile" src="{% if section.settings.retro_banner_mobile != blank %}{{ section.settings.retro_banner_mobile | image_url:width:1200 }}{% else %}{{ 'mt-ronaldinho-retro-mobile-v20.jpg' | asset_url }}{% endif %}" alt="Ronaldinho — camisas retrô" hidden><div class="mt-retro-feature__shade"></div><div class="mt-shell mt-retro-feature__content"><span class="mt-kicker">RELÍQUIAS DO FUTEBOL</span><h2>BOAS<br>LEMBRANÇAS</h2><p>Conheça as camisetas que marcaram época.</p><a class="mt-button" href="{{ retro_collection.url }}">VER CAMISAS RETRÔ</a></div></section>
{% if nba_collection != blank %}<section class="mt-section mt-section--dark"><div class="mt-shell"><div class="mt-heading"><div><span>DIRETO DAS QUADRAS</span><h2>NBA</h2></div><a href="{{ nba_collection.url }}">VER TODOS</a></div></div></section>{% endif %}</div>
{% schema %}{"name":"MT Sports — Home","settings":[{"type":"collection","id":"ready_collection","label":"Pronta entrega"},{"type":"collection","id":"winter_collection","label":"Conjuntos de inverno"},{"type":"collection","id":"nba_collection","label":"NBA"},{"type":"collection","id":"retro_collection","label":"Retrô"},{"type":"image_picker","id":"retro_banner_desktop","label":"Ronaldinho — desktop"},{"type":"image_picker","id":"retro_banner_mobile","label":"Ronaldinho — mobile"}],"presets":[{"name":"MT Sports — Home"}]}{% endschema %}