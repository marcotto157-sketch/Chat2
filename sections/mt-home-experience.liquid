{% comment %} MT Sports home experience — badges updated {% endcomment %}
<section class="mt-home-experience" style="background:#050505;color:#fff;padding:28px 14px;"><div style="max-width:1200px;margin:0 auto;">{% if section.settings.title != blank %}<h2 style="color:#fff;text-align:center;margin:0 0 22px;font-weight:800;">{{ section.settings.title }}</h2>{% endif %}<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;">{% assign mt_collection = collections[section.settings.collection] %}{% for product in mt_collection.products limit: section.settings.products_to_show %}{% assign mt_title = product.title | downcase %}{% assign mt_ready = false %}{% if mt_title contains 'pronta entrega' or mt_title contains 'pronto entrega' %}{% assign mt_ready = true %}{% endif %}{% assign mt_shirt = true %}{% if mt_title contains 'kit infantil' or mt_title contains 'kit de inverno' or mt_title contains 'conjunto' or mt_title contains 'regata' or mt_title contains 'nba' %}{% assign mt_shirt = false %}{% endif %}<a href="{{ product.url }}" style="color:#fff;text-decoration:none;display:block;"><div style="background:#111;border-radius:8px;overflow:hidden;">{% if product.featured_image %}<img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.featured_image.alt | escape }}" style="display:block;width:100%;aspect-ratio:1/1;object-fit:cover;">{% endif %}<div style="padding:12px;"><div style="font-weight:700;line-height:1.3;">{{ product.title }}</div><div style="margin-top:6px;font-weight:800;">{{ product.price | money }}</div><div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:9px;">{% if mt_ready %}<span style="padding:4px 8px;background:#fff;color:#111;border-radius:3px;font-size:10px;font-weight:800;">PRONTA ENTREGA</span>{% else %}<span style="padding:4px 8px;border:1px solid #888;color:#fff;border-radius:3px;font-size:10px;font-weight:800;">PRODUTO IMPORTADO</span>{% endif %}{% if mt_shirt %}<span style="padding:4px 8px;background:#fff;color:#111;border-radius:3px;font-size:10px;font-weight:800;">PAGUE 2, LEVE 3</span>{% endif %}</div></div></div></a>{% endfor %}</div></div></section>{% schema %}{"name":"MT Home Experience","settings":[{"type":"text","id":"title","label":"Título","default":"Destaques"},{"type":"collection","id":"collection","label":"Coleção"},{"type":"range","id":"products_to_show","label":"Produtos","min":4,"max":24,"step":1,"default":8}],"presets":[{"name":"MT Home Experience"}]}{% endschema %}