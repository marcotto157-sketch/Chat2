<section class="mt-main-banner-v21" data-mt-banner>
  <div class="mt-main-banner-v21__viewport">
    <div class="mt-main-banner-v21__track">
      <article class="mt-main-banner-v21__slide is-active" data-slide="0">
        <picture>
          <source media="(max-width:700px)" srcset="{{ 'Anderson-Porfirio-mobile.png' | file_url }}">
          <img src="{{ 'Anderson-Porfirio-pc.png' | file_url }}" alt="Compre 2 Leve 3" loading="eager">
        </picture>
      </article>

      <article class="mt-main-banner-v21__slide mt-main-banner-v21__slide--memphis" data-slide="1">
        <div class="mt-main-banner-v21__memphis-bg"></div>
        <div class="mt-main-banner-v21__memphis-photo"></div>
        <div class="mt-main-banner-v21__memphis-shade"></div>
        <div class="mt-main-banner-v21__memphis-copy">
          <span class="mt-main-banner-v21__kicker">DISPONÍVEIS AGORA</span>
          <h2>PRONTA<br><span>ENTREGA</span></h2>
          <p>Produtos selecionados com entrega de 7 a 15 dias úteis.</p>
          <a href="/collections/pronta-entrega" class="mt-main-banner-v21__button">VER PRODUTOS</a>
        </div>
      </article>

      <article class="mt-main-banner-v21__slide" data-slide="2">
        <picture>
          <source media="(max-width:700px)" srcset="{{ 'neymar_vertical_mesma_proporcao.png' | file_url }}">
          <img src="{{ 'ChatGPT_Image_15_de_ago._de_2026_03_41_33.png' | file_url }}" alt="Camisas 26 e 27 já disponíveis" loading="lazy">
        </picture>
      </article>

      <a class="mt-main-banner-v21__slide" data-slide="3" href="/pages/prazo-e-funcionamento-das-entregas">
        <picture>
          <source media="(max-width:700px)" srcset="{{ 'ChatGPT_Image_15_de_ago._de_2026_21_15_02.png' | file_url }}">
          <img src="{{ 'ChatGPT_Image_15_de_ago._de_2026_21_07_59.png' | file_url }}" alt="Conheça nossos métodos de envio" loading="lazy">
        </picture>
      </a>
    </div>

    <button class="mt-main-banner-v21__arrow mt-main-banner-v21__arrow--prev" type="button" aria-label="Banner anterior">‹</button>
    <button class="mt-main-banner-v21__arrow mt-main-banner-v21__arrow--next" type="button" aria-label="Próximo banner">›</button>
    <div class="mt-main-banner-v21__dots" aria-label="Navegação dos banners">
      <button class="is-active" type="button" data-dot="0" aria-label="Banner 1"></button>
      <button type="button" data-dot="1" aria-label="Banner 2"></button>
      <button type="button" data-dot="2" aria-label="Banner 3"></button>
      <button type="button" data-dot="3" aria-label="Banner 4"></button>
    </div>
  </div>
</section>

<style>
.mt-main-banner-v21{background:#050506;padding:0;margin:0;color:#fff}
.mt-main-banner-v21__viewport{position:relative;width:min(1800px,100%);margin:0 auto;aspect-ratio:3/1;overflow:hidden;background:#050506}
.mt-main-banner-v21__track,.mt-main-banner-v21__slide{position:absolute;inset:0}
.mt-main-banner-v21__slide{display:block;opacity:0;visibility:hidden;transition:opacity .55s ease;background:#050506;pointer-events:none}
.mt-main-banner-v21__slide.is-active{opacity:1;visibility:visible;pointer-events:auto;z-index:2}
.mt-main-banner-v21__slide picture,.mt-main-banner-v21__slide picture img{display:block;width:100%;height:100%}
.mt-main-banner-v21__slide picture img{object-fit:cover;object-position:center}
.mt-main-banner-v21__arrow{position:absolute;z-index:10;top:50%;transform:translateY(-50%);width:44px;height:56px;border:1px solid rgba(255,255,255,.34);background:rgba(0,0,0,.42);color:#fff;font-size:38px;line-height:1;display:grid;place-items:center;cursor:pointer}
.mt-main-banner-v21__arrow--prev{left:14px}.mt-main-banner-v21__arrow--next{right:14px}
.mt-main-banner-v21__dots{position:absolute;z-index:10;left:50%;bottom:14px;transform:translateX(-50%);display:flex;gap:9px}
.mt-main-banner-v21__dots button{width:34px;height:3px;padding:0;border:0;background:rgba(255,255,255,.38);cursor:pointer}.mt-main-banner-v21__dots button.is-active{background:#fff}

.mt-main-banner-v21__slide--memphis{overflow:hidden;background:#050506}
.mt-main-banner-v21__memphis-bg{position:absolute;inset:-5%;background:url("{{ 'mt-ready-memphis.jpg' | asset_url }}") center/cover no-repeat;filter:blur(18px) brightness(.34) saturate(.75);transform:scale(1.08)}
.mt-main-banner-v21__memphis-photo{position:absolute;inset:0;background:url("{{ 'mt-ready-memphis.jpg' | asset_url }}") right center/contain no-repeat;z-index:1}
.mt-main-banner-v21__memphis-shade{position:absolute;inset:0;z-index:2;background:linear-gradient(90deg,#050506 0%,rgba(5,5,6,.97) 24%,rgba(5,5,6,.70) 45%,rgba(5,5,6,.16) 68%,rgba(5,5,6,.12) 100%)}
.mt-main-banner-v21__memphis-copy{position:absolute;z-index:3;left:clamp(34px,6vw,110px);top:50%;transform:translateY(-50%);width:min(44%,650px)}
.mt-main-banner-v21__kicker{display:flex;align-items:center;gap:16px;font-weight:800;letter-spacing:.22em;font-size:clamp(12px,1.05vw,17px);margin-bottom:22px}.mt-main-banner-v21__kicker:before{content:"";width:44px;height:3px;background:#c8102e;display:block}
.mt-main-banner-v21__memphis-copy h2{margin:0;font-size:clamp(50px,6vw,102px);line-height:.82;letter-spacing:-.055em;font-weight:900;color:#fff}.mt-main-banner-v21__memphis-copy h2 span{color:transparent;-webkit-text-stroke:1.35px rgba(255,255,255,.88);text-stroke:1.35px rgba(255,255,255,.88)}
.mt-main-banner-v21__memphis-copy p{font-size:clamp(15px,1.35vw,22px);line-height:1.45;margin:24px 0 26px;max-width:580px;color:#fff}
.mt-main-banner-v21__button{display:inline-flex;align-items:center;justify-content:center;min-height:56px;padding:0 30px;background:#fff;color:#050506!important;text-decoration:none!important;font-size:14px;font-weight:900;letter-spacing:.08em}

@media(max-width:700px){
 .mt-main-banner-v21__viewport{width:100%;aspect-ratio:750/1100}
 .mt-main-banner-v21__slide picture img{object-fit:cover}
 .mt-main-banner-v21__arrow{width:38px;height:48px;font-size:32px;opacity:.9}.mt-main-banner-v21__arrow--prev{left:8px}.mt-main-banner-v21__arrow--next{right:8px}
 .mt-main-banner-v21__dots{bottom:12px}.mt-main-banner-v21__dots button{width:27px}
 .mt-main-banner-v21__memphis-bg{background-image:url("{{ 'mt-ready-memphis-mobile-v16.jpg' | asset_url }}");filter:blur(12px) brightness(.32)}
 .mt-main-banner-v21__memphis-photo{background-image:url("{{ 'mt-ready-memphis-mobile-v16.jpg' | asset_url }}");background-size:cover;background-position:center top}
 .mt-main-banner-v21__memphis-shade{background:linear-gradient(0deg,#050506 0%,rgba(5,5,6,.86) 31%,rgba(5,5,6,.18) 68%,rgba(5,5,6,.14) 100%)}
 .mt-main-banner-v21__memphis-copy{left:24px;right:24px;bottom:92px;top:auto;transform:none;width:auto}
 .mt-main-banner-v21__kicker{font-size:12px;margin-bottom:14px;gap:12px}.mt-main-banner-v21__kicker:before{width:32px}
 .mt-main-banner-v21__memphis-copy h2{font-size:clamp(48px,14vw,78px)}
 .mt-main-banner-v21__memphis-copy p{font-size:16px;margin:18px 0 20px;max-width:360px}
 .mt-main-banner-v21__button{min-height:52px;padding:0 24px}
}
</style>

<script>
(function(){
  function initBanner(root){
    if(!root || root.dataset.ready==='1') return;
    root.dataset.ready='1';
    var slides=[].slice.call(root.querySelectorAll('[data-slide]'));
    var dots=[].slice.call(root.querySelectorAll('[data-dot]'));
    var index=0,timer=null,startX=0;
    function show(i){index=(i+slides.length)%slides.length;slides.forEach(function(s,n){s.classList.toggle('is-active',n===index)});dots.forEach(function(d,n){d.classList.toggle('is-active',n===index)});}
    function restart(){clearInterval(timer);timer=setInterval(function(){show(index+1)},8000)}
    var prev=root.querySelector('.mt-main-banner-v21__arrow--prev'),next=root.querySelector('.mt-main-banner-v21__arrow--next');
    if(prev)prev.addEventListener('click',function(){show(index-1);restart()});if(next)next.addEventListener('click',function(){show(index+1);restart()});
    dots.forEach(function(d,n){d.addEventListener('click',function(){show(n);restart()})});
    root.addEventListener('touchstart',function(e){startX=e.changedTouches[0].clientX},{passive:true});root.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-startX;if(Math.abs(dx)>45){show(index+(dx<0?1:-1));restart()}},{passive:true});
    show(0);restart();
  }
  function run(){document.querySelectorAll('[data-mt-banner]').forEach(initBanner)}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',run);else run();
})();
</script>

