<section class="mt-reviews-dark" data-section-id="{{ section.id }}" data-section-type="review-list" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px"><div class="container"><div class="row-fluid">{% if section.settings.title != blank %}<header class="section__header"><div class="section__header-stack"><h2 class="section__title heading h3">{{ section.settings.title }}</h2></div></header>{% endif %}<div class="carousel review-list">{% for block in section.blocks %}<div class="review" data-review-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}><div class="review-card"><p class="review-heading">{{ block.settings.person_name }}</p><p class="review-subheading">{{ block.settings.review_date }}</p><p class="review-body">{{ block.settings.review_description }}</p><p class="review-stars">{% for i in (1..block.settings.amount_stars) %}<span class="star"></span>{% endfor %}</p></div></div>{% endfor %}</div><div class="review-audited">{{ 'home_page.review.audited_review' | t }} <img src="{{ 'Logo RD tesmoney.png' | asset_img_url:'90x' }}" alt="Avaliações auditadas" width="90" height="auto"></div></div></div></section>
<style>
.mt-reviews-dark{background:#07090d!important;color:#fff!important;min-height:0!important;height:auto!important}.mt-reviews-dark .container{width:min(1240px,calc(100% - 40px))!important;max-width:1240px!important;margin:0 auto!important;padding:0!important;background:transparent!important}.mt-reviews-dark .row-fluid,.mt-reviews-dark .section__header,.mt-reviews-dark .section__header-stack{background:transparent!important;color:#fff!important}.mt-reviews-dark .section__header{margin:0 0 28px!important;padding:0!important;text-align:left!important}.mt-reviews-dark .section__title{margin:0!important;color:#fff!important;font-size:clamp(28px,3vw,42px)!important;line-height:1.12!important;font-weight:700!important}.mt-reviews-dark .review-list{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:18px!important;width:100%!important;margin:0!important;padding:0!important;transform:none!important;background:transparent!important;overflow:visible!important}.mt-reviews-dark .review{display:block!important;position:relative!important;inset:auto!important;float:none!important;width:auto!important;min-width:0!important;height:auto!important;opacity:1!important;visibility:visible!important;transform:none!important;margin:0!important;padding:0!important;color:#fff!important}.mt-reviews-dark .review-card{display:block!important;height:100%!important;min-height:180px!important;padding:24px!important;background:#11151c!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:10px!important;color:#fff!important;box-shadow:none!important}.mt-reviews-dark .review-heading{margin:0 0 5px!important;color:#fff!important;font-weight:800!important;font-size:16px!important}.mt-reviews-dark .review-subheading{margin:0 0 16px!important;color:#aeb3bc!important;font-size:12px!important}.mt-reviews-dark .review-body{margin:0 0 18px!important;color:#f4f4f4!important;font-size:14px!important;line-height:1.55!important}.mt-reviews-dark .review-stars{display:flex!important;gap:3px!important;margin:0!important;color:#fff!important}.mt-reviews-dark .star{display:inline-block!important;width:auto!important;height:auto!important;background:none!important}.mt-reviews-dark .star:before{content:'★'!important;display:inline-block!important;color:#fff!important;font-size:15px!important;line-height:1!important}.mt-reviews-dark .review-audited{display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:10px!important;margin-top:20px!important;color:#aeb3bc!important;font-size:12px!important;background:transparent!important}.mt-reviews-dark .review-audited img{display:block!important;max-width:90px!important;height:auto!important;filter:none!important}@media(max-width:900px){.mt-reviews-dark .review-list{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@media(max-width:700px){.mt-reviews-dark .container{width:calc(100% - 32px)!important}.mt-reviews-dark .section__header{margin-bottom:20px!important}.mt-reviews-dark .section__title{font-size:30px!important}.mt-reviews-dark .review-list{display:flex!important;gap:12px!important;overflow-x:auto!important;scroll-snap-type:x mandatory!important;padding-bottom:8px!important}.mt-reviews-dark .review{flex:0 0 84%!important;scroll-snap-align:start!important}.mt-reviews-dark .review-card{min-height:170px!important;padding:20px!important}.mt-reviews-dark .review-audited{justify-content:flex-start!important}}
</style>
{% schema %}{"name":"Avaliações","settings":[{"type":"text","id":"title","label":"Título","default":"O que os clientes falam sobre nós"},{"type":"range","id":"padding_top","min":0,"max":100,"step":5,"unit":"px","label":"Espaço superior","default":40},{"type":"range","id":"padding_bottom","min":0,"max":100,"step":5,"unit":"px","label":"Espaço inferior","default":40}],"blocks":[{"type":"review","name":"Avaliação","settings":[{"type":"text","id":"person_name","label":"Nome"},{"type":"text","id":"review_date","label":"Data"},{"type":"textarea","id":"review_description","label":"Avaliação"},{"type":"range","id":"amount_stars","min":1,"max":5,"step":1,"label":"Estrelas","default":5}]}],"presets":[{"name":"Avaliações","category":"Texto"}]}{% endschema %}