<div id="mini-cart" class="mini-cart">
<form method="post" action="{{ routes.cart_url }}" aria-hidden="true" novalidate="novalidate" data-item-count="{{ cart.item_count }}"><div class="justWrapper">
<header class="drawer__header"><p class="drawer__title heading">{% render 'icon', icon: 'cart' %} <span>{{ cart.item_count }} {{ cart.item_count | pluralize: 'item','itens' }}</span></p><button type="button" class="drawer__close-button tap-area" onclick="closeCart()" data-action="close" aria-label="Fechar">{% render 'icon', icon: 'close' %}</button></header>
{% if cart.item_count == 0 %}<div class="mini-cart__content mini-cart__content--empty"><div class="mini-cart__empty-state"><div class="empty-state__icon">{% render 'icon', icon: 'big-cart' %}</div><p class="empty-state__heading heading h1">Seu carrinho está vazio</p></div><button type="button" onclick="closeCart()" class="button button--secondary button--full">CONTINUAR COMPRANDO</button></div>{% else %}
<div class="mini-cart__inner"><div class="mini-cart__content"><div class="mini-cart__line-item-list">{% for line_item in cart.items %}<div class="mini-cart__line-item"><div class="mini-cart__image-wrapper"><div class="aspect-ratio aspect-ratio--square"><img src="{{ line_item.image | img_url:'180x' }}" alt="{{ line_item.image.alt | escape }}"></div></div><div class="mini-cart__item-wrapper"><div class="mini-cart__product-info"><a href="{{ line_item.url }}" class="mini-cart__product-title text--strong link">{{ line_item.title }}</a><div class="mini-cart__price-list"><span class="price">{{ line_item.final_line_price | money }}</span></div></div><div class="mini-cart__quantity"><div class="quantity-selector"><button type="button" class="quantity-selector__button" data-action="decrease-quantity" data-quantity="{{ line_item.quantity | minus:1 }}" data-line-id="{{ line_item.key }}" aria-label="Diminuir">{% render 'icon',icon:'minus' %}</button><input class="quantity-selector__value" data-current-value="{{ line_item.quantity }}" data-line-id="{{ line_item.id }}" value="{{ line_item.quantity }}"><button type="button" class="quantity-selector__button" data-action="increase-quantity" data-quantity="{{ line_item.quantity | plus:1 }}" data-line-id="{{ line_item.key }}" aria-label="Aumentar">{% render 'icon',icon:'plus' %}</button></div><a href="{{ routes.cart_change_url }}?quantity=0&id={{ line_item.key }}" data-action="decrease-quantity" data-quantity="0" data-line-id="{{ line_item.key }}" class="mini-cart__quantity-remove link">Remover</a></div></div></div>{% endfor %}</div></div></div>
<div class="mini-cart__recap"><div class="mini-cart__recap-price-line"><span>Total</span><span>{{ cart.total_price | money }}</span></div><div style="margin-top:12px"><button type="submit" name="checkout" class="button button--primary" style="width:100%;text-transform:uppercase">FINALIZAR COMPRA</button><button type="button" class="button button--secondary" onclick="closeCart()" style="width:100%;margin-top:10px;text-transform:uppercase">CONTINUAR COMPRANDO</button></div></div>{% endif %}
</div></form></div>
