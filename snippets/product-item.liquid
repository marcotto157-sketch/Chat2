{% comment %} MT Sports product card badges — Chat2 Tela {% endcomment %}
{% assign mt_title = product.title | downcase %}
{% assign mt_ready = false %}
{% if mt_title contains 'pronta entrega' or mt_title contains 'pronto entrega' %}{% assign mt_ready = true %}{% endif %}
{% assign mt_shirt = true %}
{% if mt_title contains 'kit infantil' or mt_title contains 'kit de inverno' or mt_title contains 'conjunto' or mt_title contains 'regata' or mt_title contains 'nba' %}{% assign mt_shirt = false %}{% endif %}
<div class="product-item product-item--vertical 1/3--tablet-and-up 1/4--desk"><a href="{{ product.url }}" class="product-item__image-wrapper product-item__image-wrapper--with-secondary"><div class="aspect-ratio" style="padding-bottom:100%">{% if product.featured_image %}<img class="product-item__primary-image lazyload image--fade-in" data-media-id="{{ product.featured_image.id }}" data-src="{{ product.featured_image | img_url: '600x' }}" data-widths="[200,300,400,500,600]" data-sizes="auto" alt="{{ product.featured_image.alt | escape }}">{% endif %}</div></a><div class="product-item__info"><div class="product-item__info-inner"><a href="{{ product.url }}" class="product-item__title text--strong link">{{ product.title }}</a><div class="product-item__price-list price-list"><span class="price">{{ product.price | money }}</span></div><div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;">{% if mt_ready %}<span style="display:inline-block;padding:4px 9px;border-radius:3px;background:#fff;color:#111;font-size:10px;font-weight:800;letter-spacing:.04em;line-height:1.2;">PRONTA ENTREGA</span>{% else %}<span style="display:inline-block;padding:4px 9px;border-radius:3px;border:1px solid rgba(255,255,255,.55);color:#fff;font-size:10px;font-weight:800;letter-spacing:.04em;line-height:1.2;">PRODUTO IMPORTADO</span>{% endif %}{% if mt_shirt %}<span style="display:inline-block;padding:4px 9px;border-radius:3px;background:#fff;color:#111;font-size:10px;font-weight:800;letter-spacing:.04em;line-height:1.2;">PAGUE 2, LEVE 3</span>{% endif %}</div></div></div></div>