<link rel="stylesheet" href="{{ 'mt-cart-drawer.css' | asset_url }}">
<script>
(function(){
  window.__mtCartManualCheckout=true;
  function neutralizeAutoCheckout(){
    document.querySelectorAll('a[href*="/checkout"],form[action*="/checkout"]').forEach(function(el){if(el.closest('#mini-cart'))return;});
  }
  document.addEventListener('click',function(e){
    var checkout=e.target.closest('#mini-cart a[href*="checkout"],#mini-cart button[name="checkout"],#mini-cart input[name="checkout"]');
    if(checkout){ return; }
  },true);
  document.addEventListener('cart:refresh',neutralizeAutoCheckout);
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',neutralizeAutoCheckout);else neutralizeAutoCheckout();
})();
</script>
