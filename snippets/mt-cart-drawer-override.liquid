<link rel="stylesheet" href="{{ 'mt-cart-drawer.css' | asset_url }}">
<script>
(function(){
  window.__mtCartManualCheckout=true;
  function isInsideCart(el){return !!(el&&el.closest&&el.closest('#mini-cart'));}
  function stopAutoCheckout(e){
    var el=e.target&&e.target.closest?e.target.closest('a,button,input,form'):null;
    if(!isInsideCart(el)) return;
    var href=(el.getAttribute&&el.getAttribute('href'))||'';
    var name=(el.getAttribute&&el.getAttribute('name'))||'';
    if(/checkout/i.test(href)||name==='checkout') return; // só o clique explícito de finalizar pode sair
  }
  document.addEventListener('click',stopAutoCheckout,true);
  document.addEventListener('cart:refresh',function(){
    // mantém o cliente no drawer; checkout somente por ação explícita
    if(location.pathname.indexOf('/checkout')===-1){window.__mtCartManualCheckout=true;}
  });
})();
</script>
