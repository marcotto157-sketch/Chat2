<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">
  <title>{% if page_title == blank %}{{ shop.name }}{% else %}{{ page_title }}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}{% endif %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ 'mt-product-final-fix.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ template.name | handle }}">
  {{ content_for_layout }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'mt-personalizacao-fix.js' | asset_url }}" defer></script>
  <script src="{{ 'mt-product-gallery-fix.js' | asset_url }}" defer></script>
</body>
</html>