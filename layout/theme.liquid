                                                                                                                                                                                                                                background: linear-gradient(
                                                                                                                                                                                                                                      135deg,
                                                                                                                                                                                                                                            #833ab4,
                                                                                                                                                                                                                                                  #fd1d1d,
                                                                                                                                                                                                                                                        #fcb045
                                                                                                                                                                                                                                                            );
                                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                                                .mt-instagram svg {
                                                                                                                                                                                                                                                                    width: 30px;
                                                                                                                                                                                                                                                                        height: 30px;
                                                                                                                                                                                                                                                                            fill: #ffffff;
                                                                                                                                                                                                                                                                              }

                                                                                                                                                                                                                                                                                /* WhatsApp */
