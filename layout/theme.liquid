                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                        .mt-social-button {
                                                                                                                                                                                                                                                                                                                                                              width: 52px;
                                                                                                                                                                                                                                                                                                                                                                    height: 52px;
                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                            .mt-instagram svg {
                                                                                                                                                                                                                                                                                                                                                                                  width: 28px;
                                                                                                                                                                                                                                                                                                                                                                                        height: 28px;
                                                                                                                                                                                                                                                                                                                                                                                            }

                                                                                                                                                                                                                                                                                                                                                                                                .mt-whatsapp svg {
